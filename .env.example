# Voice Service Configuration

# Service
SERVICE_NAME=voice-service
PORT=3006

# ElevenLabs API
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Wake word config (comma-separated phrases, case-insensitive fuzzy match)
WAKE_WORD_PHRASES=thinkdrop,think drop,hey thinkdrop,hey think drop,you awake,wake up,are you there,listen up,i need you
WAKE_WORD_SENSITIVITY=0.6

# Voice journal path (shared with StateGraph)
VOICE_JOURNAL_PATH=~/.thinkdrop/voice-state.json

# Language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,zh,es,fr,pt,ar,ja,ko,hi,de,it,ru
AUTO_TRANSLATE=true

# StateGraph backend WebSocket (for fast-lane LLM queries)
STATEGRAPH_WS_URL=ws://localhost:4000/ws/stream
STATEGRAPH_API_KEY=test-api-key-123

# ThinkDrop main process (for StateGraph injection)
THINKDROP_MAIN_PORT=3010
MCP_VOICE_API_KEY=some-voice-api-key


# Logging
LOG_LEVEL=info
DEBUG_MODE=false
